{
  "defaults": {
    "ttl_seconds": 600,
    "provider_timeout_seconds": 30,
    "github_user": "you",
    "recent_days": 7
  },
  "sources": [
    {
      "provider": "github-notifications"
    }
  ],
  "actions": [
    {
      "icon": "⎇",
      "description": "check out the PR branch",
      "command": "gh pr checkout -R \"$EPHOR_REPO\" \"$EPHOR_NUMBER\"",
      "kinds": ["pr"]
    },
    {
      "icon": "🧪",
      "description": "run the tests",
      "command": "just test"
    }
  ],
  "work": {
    "root": "{workspace}/panta",
    "recipes": [
      {
        "id": "fix-gate",
        "icon": "🛠",
        "description": "fix the red gate",
        "state": "fix",
        "needs_checkout": true,
        "when": { "kinds": ["pr"], "roles": ["author"], "gate": "failing" },
        "brief": "The gate on {title} is red. The failing jobs are named above; find what actually broke and fix the cause. Run `just check` in {workspace} before you call it done."
      }
    ]
  },
  "projects": {
    "widget": {
      "checkout": {
        "description": "create the branch workspace",
        "command": "git worktree add \"$EPHOR_WORKSPACE\" \"$EPHOR_BRANCH\""
      },
      "work": {
        "recipes": [
          {
            "id": "bench",
            "icon": "📈",
            "description": "run the benchmarks against main",
            "state": "fix",
            "needs_checkout": true,
            "when": { "kinds": ["pr"], "roles": ["author"] },
            "brief": "Run the benchmark suite on {branch} and against {root}'s main branch, and write the comparison into the report. Change nothing."
          }
        ]
      },
      "actions": [
        {
          "icon": "💡",
          "description": "open the app in the editor",
          "command": "nohup $EDITOR \"$EPHOR_WORKSPACE/app\" >/dev/null 2>&1 &",
          "requires_checkout": true
        }
      ],
      "providers": [
        { "provider": "github-prs", "repos": ["acme/widget"], "reviews": true },
        { "provider": "github-ci", "repos": ["acme/widget"] },
        { "provider": "github-threads", "repos": ["acme/widget"] },
        { "provider": "github-issues", "repos": ["acme/widget"] },
        {
          "provider": "custom-status",
          "format": "answer",
          "command": "printf '{\"v\":1,\"summary\":\"%s uncommitted file(s)\"}' \"$(git -C app status --short | wc -l)\" > \"$EPHOR_ANSWER\""
        }
      ]
    },
    "notes": {
      "providers": [
        { "provider": "github-prs", "repos": ["you/notes"], "reviews": true },
        { "provider": "github-ci", "repos": ["you/notes"] },
        {
          "provider": "github-issues",
          "participating": true,
          "updated_within_days": 30
        }
      ]
    }
  }
}
