{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Registry",
  "type": "object",
  "required": ["project_types", "hook_sets", "projects"],
  "properties": {
    "organizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "root": {
            "type": "string",
            "minLength": 1,
            "description": "Folder holding this organization's checkouts"
          },
          "default_tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "project_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "layout", "repos", "agents"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "layout": { "enum": ["monorepo", "polyrepo"] },
          "repos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "path", "role", "required", "update_mode"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" },
                "update_mode": { "enum": ["branch", "skip"] },
                "default_branch": { "type": "string" },
                "agents_description": { "type": "string" },
                "agents_guide": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "agents": {
            "type": "object",
            "required": ["template", "structure_intro"],
            "properties": {
              "template": { "type": "string", "minLength": 1 },
              "structure_intro": { "type": "string", "minLength": 1 },
              "summary_template": { "type": "string" },
              "summary_with_ticket_template": { "type": "string" },
              "summary_without_ticket_template": { "type": "string" },
              "validations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["command"],
                  "properties": {
                    "cwd": { "type": "string" },
                    "command": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": true
          },
          "update_hooks": {
            "type": "object",
            "properties": {
              "pre": { "type": "array", "items": { "type": "string" } },
              "post": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "hook_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "hooks"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "hooks": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "required": ["command"],
                  "properties": {
                    "command": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "cwd": { "type": "string", "minLength": 1 },
                    "pass_debug": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "display_name", "root", "main_branch"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "aliases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Alternative names for this project (useful for polyrepos with multiple repos)"
          },
          "manifest_trust": {
            "enum": ["full", "descriptions", "ignore"],
            "description": "How much of the project's own ephor.json to believe (FS-006-project-interface.2): 'full' honors it, 'descriptions' reads what it says about itself and runs none of it, 'ignore' does not read it. Default: full."
          },
          "territory": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Repositories and organizations that are this project's business without being in its forest (FS-008-attribution.1): 'owner/name' for one repository, 'owner' for a whole organization. What places a mention or an issue filed in the project's ecosystem."
          },
          "organization": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string", "minLength": 1 },
          "root": { "type": "string", "minLength": 1 },
          "main_branch": { "type": "string", "minLength": 1 },
          "required_branch_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Branch entry ids that must exist in release_branches or branches"
          },
          "clone_mode": { "enum": ["worktree", "full-clone"], "default": "full-clone" },
          "branch_root_template": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "vars": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number", "boolean"]
            }
          },
          "repo_overrides": {
            "type": "object",
            "additionalProperties": { "type": "object" }
          },
          "agents_overrides": {
            "type": "object",
            "additionalProperties": true
          },
          "release_branches": {
            "type": "array",
            "items": { "$ref": "#/$defs/branch_entry" }
          },
          "branches": {
            "type": "array",
            "items": { "$ref": "#/$defs/branch_entry" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "branch_entry": {
      "type": "object",
      "required": ["id", "branch", "active"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "active": { "type": "boolean" },
        "display_name": { "type": "string" },
        "ticket": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "vars": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "repo_overrides": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "agents_overrides": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
